-- ================================================
-- ACTIVITY INFO TAB (CROSS-EXECUTOR FIXED)
-- ================================================

-- Cross-executor compatibility patch
local Env = getgenv and getgenv() or shared or _G

-- Safe firesignal (FIXED)
if not firesignal then
    function firesignal(signal, ...)
        pcall(signal.Fire, signal, ...)
    end
end

-- Safe newcclosure
if not newcclosure then
    function newcclosure(fn)
        return fn
    end
end

-- Safe setclipboard
if not setclipboard then
    function setclipboard(text)
        if writeclipboard then
            writeclipboard(text)
        elseif syn and syn.write_clipboard then
            syn.write_clipboard(text)
        end
    end
end

repeat task.wait() until Env.Window
local Window = Env.Window

local ActivityTab = Window:CreateTab("Activity Info", nil)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local request = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)

if not request then
    ActivityTab:CreateSection("Error")
    ActivityTab:CreateLabel("Your executor doesn't support webhooks!")
    return
end

-- ======================================
-- LOAD SAVED SETTINGS
-- ======================================
local settings = Env.HubSettings or {}
if not settings.activity then settings.activity = {} end
local activitySettings = settings.activity

-- ======================================
-- SETTINGS
-- ======================================
local activityWebhookURL = activitySettings.webhookURL or ""
local activityEnabled = activitySettings.enabled or false
local lastSent = ""

-- Initialize global activity tracker
if not Env.ActivityStatus then
    Env.ActivityStatus = {
        current = "Idle",
        trigger = false,
    }
end

-- ======================================
-- FUNCTIONS
-- ======================================
local function sendActivity(msg)
    if not activityEnabled then return end
    if activityWebhookURL == "" then return end
    if msg == lastSent then return end
    
    lastSent = msg
    
    pcall(function()
        request({
            Url = activityWebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                embeds = {{
                    title = "Activity Update",
                    description = "**" .. player.Name .. "**\n" .. msg,
                    color = 5814783,
                    footer = {text = "Renoa Hub * " .. os.date("%Y-%m-%d %H:%M:%S")}
                }}
            })
        })
    end)
end

-- Monitor global activity trigger
task.spawn(function()
    while true do
        task.wait(3)
        local status = Env.ActivityStatus
        if status.trigger and status.current ~= lastSent then
            sendActivity(status.current)
            status.trigger = false
        end
    end
end)

-- ======================================
-- UI
-- ======================================
ActivityTab:CreateSection("Activity Info")

ActivityTab:CreateLabel("Sends webhook when your character is actively doing something")
ActivityTab:CreateLabel("Only sends when the action is actually being performed, not on toggle")
ActivityTab:CreateLabel("Discord User ID is used by other tabs for pinging you!")

ActivityTab:CreateInput({
    Name = "Activity Webhook URL",
    CurrentValue = activityWebhookURL,
    PlaceholderText = "https://discord.com/api/webhooks/...",
    RemoveTextAfterFocusLost = false,
    Callback = function(v)
        activityWebhookURL = v
        activitySettings.webhookURL = v
        Env.HubSettings.activity = activitySettings
        saveHubSettings()
    end
})

ActivityTab:CreateInput({
    Name = "Discord User ID (for pings in other tabs)",
    CurrentValue = activitySettings.userId or "",
    PlaceholderText = "Discord_User_ID",
    RemoveTextAfterFocusLost = false,
    Callback = function(v)
        activitySettings.userId = v
        Env.HubSettings.activity = activitySettings
        saveHubSettings()
    end
})

ActivityTab:CreateToggle({
    Name = "Turn On/Turn Off",
    CurrentValue = activityEnabled,
    Callback = function(v)
        activityEnabled = v
        lastSent = ""
        activitySettings.enabled = v
        Env.HubSettings.activity = activitySettings
        saveHubSettings()
    end
})

print("[Activity Info] Loaded!")
